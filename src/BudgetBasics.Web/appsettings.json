{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=BudgetBasicsDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Database": {
    "ApplyMigrations": false
  },
  "Jwt": {
    "Issuer": "BudgetBasics",
    "Audience": "BudgetBasics.Mvc",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Gemini": {
    "Enabled": true,
    "Model": "gemini-3.8-flash",
    "TimeoutSeconds": 15,
    "MaxOutputTokens": 350
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
