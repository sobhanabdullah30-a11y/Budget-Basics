{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=BudgetBasicsDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Database": {
    "ApplyMigrations": false
  },
  "Caching": {
    "PublicPageSeconds": 300,
    "ReferenceDataSeconds": 60,
    "StaticAssetSeconds": 31536000,
    "OutputCacheSizeMegabytes": 50,
    "MaximumCachedResponseKilobytes": 1024
  },
  "Cdn": {
    "Enabled": false,
    "BaseUrl": ""
  },
  "RateLimiting": {
    "GlobalPermitLimit": 300,
    "GlobalWindowSeconds": 60,
    "GlobalSegmentsPerWindow": 6,
    "AuthenticationPermitLimit": 10,
    "AuthenticationWindowSeconds": 60,
    "AssistantPermitLimit": 10,
    "AssistantWindowSeconds": 60,
    "ApiPermitLimit": 60,
    "ApiWindowSeconds": 60
  },
  "Jwt": {
    "Issuer": "BudgetBasics",
    "Audience": "BudgetBasics.Mvc",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Gemini": {
    "Enabled": true,
    "Model": "gemini-3.8-flash",
    "TimeoutSeconds": 15,
    "MaxOutputTokens": 350
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
