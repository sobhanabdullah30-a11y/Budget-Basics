<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="BudgetBasics helps students learn practical budgeting, saving, and responsible spending." />
    <title>@ViewData["Title"] | BudgetBasics</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="site-body">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="scroll-progress" aria-hidden="true"><span id="scroll-progress-bar"></span></div>
    <header class="site-header">
        <div class="tip-ticker"><span>Budget tip:</span> Plan your needs first, save something second, then enjoy what remains.</div>
        <nav class="navbar navbar-expand-lg" aria-label="Primary navigation">
            <div class="container">
                <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark" aria-hidden="true">B</span><span>Budget<span>Basics</span></span><span class="visually-hidden"> home</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Open navigation"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item"><a class="nav-link" data-section="learn" href="/#learn">Learn</a></li><li class="nav-item"><a class="nav-link" data-section="tools" href="/#tools">Practice</a></li><li class="nav-item"><a class="nav-link" data-section="mistakes" href="/#mistakes">Money mistakes</a></li><li class="nav-item"><a class="nav-link" data-section="resources" href="/#resources">Resources</a></li><li class="nav-item"><a class="nav-link" data-section="assistant" href="/#assistant">Get help</a></li>
                    </ul>
                    <div class="nav-actions">
                        <button class="icon-button theme-toggle" id="theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false" title="Switch light or dark theme"><span class="theme-sun" aria-hidden="true">☀</span><span class="theme-moon" aria-hidden="true">◐</span></button>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="btn btn-soft" asp-controller="Account" asp-action="Profile">My account</a>
                            <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-primary" type="submit">Sign out</button></form>
                        }
                        else
                        {
                            <a class="btn btn-soft" asp-controller="Account" asp-action="Login">Log in</a><a class="btn btn-primary" asp-controller="Account" asp-action="Register">Get started</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="container"><div class="status-banner" role="status">@statusMessage</div></div>
    }
    <main id="main-content">@RenderBody()</main>
    <footer class="site-footer">
        <div class="container footer-grid">
            <div><a class="brand brand-light" asp-controller="Home" asp-action="Index"><span class="brand-mark">B</span><span>Budget<span>Basics</span></span></a><p>Small steps. Stronger money habits.</p></div>
            <div><h2>Explore</h2><a href="/#learn">Learning guides</a><a href="/#tools">Planning tools</a><a href="/#resources">Infographics</a></div>
            <div><h2>Support</h2><a asp-controller="Home" asp-action="Feedback">Feedback</a><a asp-controller="Home" asp-action="Contact">Contact us</a><a asp-controller="Home" asp-action="About">About us</a><a asp-controller="Home" asp-action="Sitemap">Sitemap</a></div>
            <div><h2>Important</h2><a asp-controller="Home" asp-action="Disclaimer">Educational disclaimer</a><a asp-controller="Home" asp-action="Privacy">Privacy notice</a><p>BudgetBasics does not provide banking or professional financial advice.</p></div>
        </div>
        <div class="container footer-bottom"><span>&copy; 2026 BudgetBasics</span><a class="back-to-top" href="#main-content"><span aria-hidden="true">↑</span> Back to top</a></div>
    </footer>
    <script defer src="~/lib/jquery/dist/jquery.min.js"></script><script defer src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script defer src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
