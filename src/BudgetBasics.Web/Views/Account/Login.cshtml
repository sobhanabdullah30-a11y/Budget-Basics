@model LoginViewModel
@{ ViewData["Title"] = "Log in"; }
<section class="auth-shell"><div class="auth-card"><span class="eyebrow">Welcome back</span><h1>Continue your learning</h1><p>Your access uses short-lived JWT authentication and a rotated secure refresh session.</p><form method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]"><div asp-validation-summary="ModelOnly"></div><label asp-for="Email"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email"></span><label asp-for="Password"></label><input asp-for="Password" class="form-control" autocomplete="current-password" /><span asp-validation-for="Password"></span><button class="btn btn-primary w-100" type="submit">Log in securely</button></form><p class="auth-switch">New here? <a asp-action="Register">Create an account</a></p></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
