@model RegisterViewModel
@{ ViewData["Title"] = "Create learner account"; }
<section class="auth-shell"><div class="auth-card"><span class="eyebrow">Optional learner account</span><h1>Start learning with confidence</h1><p>Create an account to save expense-planner rows securely in SQL Server. Calculator, savings-goal and chat inputs remain temporary.</p><form method="post"><div asp-validation-summary="ModelOnly"></div><label asp-for="DisplayName"></label><input asp-for="DisplayName" class="form-control" autocomplete="name" /><span asp-validation-for="DisplayName"></span><label asp-for="Email"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email"></span><label asp-for="Password"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password"></span><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span><button class="btn btn-primary w-100" type="submit">Create secure account</button></form><p class="auth-switch">Already registered? <a asp-action="Login">Log in</a></p></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
