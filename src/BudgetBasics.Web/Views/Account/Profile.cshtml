@{ ViewData["Title"] = "My account"; }
<section class="auth-shell"><div class="auth-card profile-card"><div class="profile-badge">@((User.Identity?.Name ?? "L")[0])</div><span class="eyebrow">Secure learner profile</span><h1>@(User.Identity?.Name ?? "BudgetBasics learner")</h1><p>You are signed in through a validated JWT stored in a secure HttpOnly cookie. Your planner entries and calculator values are not saved to this account.</p><div class="panel"><b>Your privacy controls</b><ul><li>No bank account or card information is collected.</li><li>Refresh sessions can be revoked at logout.</li><li>Temporary planning data stays in the current browser tab.</li></ul></div><a class="btn btn-primary" asp-controller="Home" asp-action="Index">Continue learning</a></div></section>
